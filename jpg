<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#133668">
  <title>Квест «Де вдома найкращий Wi-Fi?»</title>
  <style>
    :root { font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif; color:#193251; background:#f3f7fc; }
    * { box-sizing:border-box; }
    body { margin:0; }
    button, input, select, textarea { font:inherit; }
    button { cursor:pointer; }
    header { padding:30px max(18px,calc((100vw - 1120px)/2)); background:linear-gradient(130deg,#10305c,#1473a8); color:white; }
    header h1 { margin:5px 0 8px; font-size:clamp(1.65rem,4vw,2.8rem); line-height:1.15; }
    header p { margin:0; max-width:720px; line-height:1.5; }
    .tag { display:inline-block; padding:5px 11px; background:#ffffff29; border:1px solid #ffffff54; border-radius:99px; font-size:.85rem; }
    main { max-width:1120px; margin:auto; padding:20px 18px 70px; }
    nav { display:flex; gap:7px; overflow-x:auto; padding:0 0 12px; }
    nav button { flex:none; background:white; color:#19517b; border:1px solid #c7d9ea; border-radius:12px; padding:9px 12px; font-weight:700; }
    nav button[aria-current="step"] { background:#1767a1; color:white; border-color:#1767a1; }
    .panel { display:none; background:white; border:1px solid #d9e5f1; border-radius:18px; padding:clamp(18px,3vw,30px); box-shadow:0 8px 22px #294f7410; }
    .panel.active { display:block; }
    h2 { margin:0 0 10px; color:#173d6d; font-size:1.45rem; }
    h3 { color:#21476e; margin:22px 0 8px; }
    p, li { line-height:1.55; }
    .two { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:start; }
    .box { padding:16px; background:#eff6fc; border-radius:12px; border-left:4px solid #4098ce; }
    .small { font-size:.9rem; color:#50657a; }
    .art { min-height:180px; display:grid; place-items:center; border:2px dashed #9cbcdc; background:linear-gradient(145deg,#edf6ff,#fafcff); border-radius:16px; text-align:center; padding:20px; color:#49698a; }
    .art img { display:block; width:100%; height:auto; max-height:290px; object-fit:contain; }
    .art img:not([src]) { display:none; }
    .art:has(img[src]) .placeholder { display:none; }
    .art .symbol { font-size:4rem; display:block; color:#1767a1; line-height:1.1; }
    label { display:block; font-weight:650; margin:12px 0 5px; }
    input[type=text], input[type=number], select, textarea { width:100%; border:1px solid #b6cadb; border-radius:9px; padding:9px 10px; color:#173450; background:white; }
    textarea { min-height:80px; resize:vertical; }
    .actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:22px; }
    .primary, .secondary { border-radius:10px; border:0; padding:10px 15px; font-weight:700; }
    .primary { background:#1767a1; color:white; }
    .secondary { background:#e8f1f9; color:#1c517e; }
    .toolbar { display:flex; flex-wrap:wrap; gap:6px; margin:12px 0; }
    .toolbar button { border:1px solid #b4cadf; border-radius:9px; padding:7px 9px; background:white; color:#1a4870; }
    .toolbar button[aria-pressed=true] { background:#155f99; color:white; }
    #map { width:100%; max-width:760px; height:auto; touch-action:manipulation; background:#fff; border:2px solid #aac6df; border-radius:10px; }
    .legend { display:flex; flex-wrap:wrap; gap:12px; font-size:.85rem; color:#345; margin:9px 0; }
    table { border-collapse:collapse; width:100%; min-width:600px; }
    th, td { padding:8px; border-bottom:1px solid #d7e5f0; text-align:left; }
    th { background:#eaf3fa; }
    td input { min-width:65px; }
    .scroller { overflow-x:auto; }
    .result { padding:13px; margin-top:14px; background:#e9f6eb; border-left:4px solid #48a968; border-radius:8px; }
    .note { background:#fff8e7; padding:13px; border-left:4px solid #e4ac37; border-radius:8px; }
    .learn { margin:18px 0; padding:14px 17px; background:#eaf3ff; border-left:5px solid #347aca; border-radius:10px; }
    .learn b { color:#163e75; }
    .check { padding:14px; border:1px solid #bed5e8; border-radius:11px; margin:14px 0; }
    .check button { display:block; width:100%; text-align:left; border:1px solid #c3d6e6; background:#fff; border-radius:8px; padding:8px 11px; margin:5px 0; }
    .check button:hover,.check button:focus { background:#e9f4ff; }
    .feedback { margin:8px 0 0; font-weight:650; min-height:1.4em; }
    .footerline { margin-top:24px; font-size:.82rem; color:#5b6b79; }
    @media(max-width:720px) { .two { grid-template-columns:1fr; } header { padding:24px 18px; } }
    @media print { header,nav,.actions,.toolbar,.footerline { display:none!important; } .panel { display:block!important; break-inside:avoid; box-shadow:none; margin:12px 0; } main { padding:0; } }
  </style>
</head>
<body>
<header>
  <span class="tag">STEM-квест· </span>
  <h1>Де вдома найкращий Wi-Fi?</h1>
  <p>Дослідіть сигнал у різних точках приміщення, створіть власну карту та обґрунтуйте місце для онлайн-уроку.</p>
</header>
<main>
  <nav aria-label="Етапи квесту">
    <button type="button" data-step="0" aria-current="step">1 · Місія</button>
    <button type="button" data-step="1">2 · Карта</button>
    <button type="button" data-step="2">3 · Вимірювання</button>
    <button type="button" data-step="3">4 · Аналіз</button>
    <button type="button" data-step="4">5 · Рішення</button>
  </nav>

  <section class="panel active" id="step0">
    <div class="two">
      <div>
        <h2>Місія: знайдіть місце для стабільного зв’язку</h2>
        <p>Під час відеоуроку в одному місці все працює, а в іншому звук і зображення перериваються. Чи пов’язано це з розташуванням смартфона відносно роутера?</p>
        <div class="box"><strong>Ваш результат:</strong> спрощена карта приміщення з вимірюваннями Wi-Fi, таблиця, висновок і перевірене рішення.</div>
        <div class="learn"><b>Коротко про Wi-Fi.</b> Роутер обмінюється даними зі смартфоном за допомогою радіохвиль. Відстань, стіни й інші перешкоди можуть послаблювати сигнал. Щоб перевірити це саме у вашому приміщенні, потрібні вимірювання.</div>
        <h3>Підготуйте</h3>
        <ul><li>смартфон, підключений до домашньої мережі Wi-Fi;</li><li>застосунок, що показує силу сигналу в dBm; якщо такого показника немає, скористайтеся поділками сигналу;</li><li>цей відкритий HTML-квест та доступ до кількох місць у приміщенні.</li></ul>
        <p class="note">Карта може бути умовною. Не записуйте адресу, назву мережі, пароль або подробиці планування дому. Працюйте лише там, де вам дозволено.</p>
        <div class="actions"><button class="primary" data-next="1">Створити карту →</button></div>
      </div>
      <div class="art" aria-label="Місце для майбутнього зображення смартфона й Wi-Fi"><img alt="Смартфон і Wi-Fi" data-future-image="image.png"><div class="placeholder"><span class="symbol">◉</span>Місце для зображення 1<br>Смартфон і домашній Wi-Fi</div></div>
    </div>
  </section>

  <section class="panel" id="step1">
    <h2>Крок 1. Створіть карту приміщення·</h2>
    <p>Позначте стіни, приблизне місце роутера <b>R</b> і 4–5 точок для вимірювання: <b>А, Б, В, Г, Д</b>. Це схема, а не точний план квартири. Обирайте інструмент і натискайте клітинки карти.</p>
    <div class="learn"><b>Навіщо карта?</b> Вона пов’язує числа з місцем вимірювання. За картою легше помітити, чи є між роутером і смартфоном стіна та де розташовані слабкі точки.</div>
    <div class="toolbar" role="group" aria-label="Інструменти карти">
      <button type="button" class="tool" data-tool="wall" aria-pressed="true">▩ Стіна</button>
      <button type="button" class="tool" data-tool="router" aria-pressed="false">◉ Роутер</button>
      <button type="button" class="tool" data-tool="point" aria-pressed="false">● Точки А–Д</button>
      <button type="button" class="tool" data-tool="erase" aria-pressed="false">⌫ Стерти</button>
    </div>
    <canvas id="map" width="800" height="500" aria-label="Редактор спрощеної карти приміщення"></canvas>
    <div class="legend"><span>▩ стіна</span><span>◉ роутер</span><span>● точка вимірювання</span><span>Колір точок з’явиться після аналізу.</span></div>
    <label for="hypothesis">Де, на вашу думку, сигнал найсильніший? Чому?</label>
    <textarea id="hypothesis" placeholder="Моя гіпотеза..." data-save></textarea>
    <div class="actions"><button class="secondary" id="resetMap">Очистити карту</button><button class="primary" data-next="2">Перейти до вимірювань →</button></div>
  </section>

  <section class="panel" id="step2">
    <div class="two">
      <div>
        <h2>Крок 2. Перевірте гіпотезу·</h2>
        <p>Зробіть <b>три вимірювання</b> в кожній точці карти. Використовуйте той самий смартфон і ту саму мережу Wi-Fi; не переставляйте роутер під час збору даних.</p>
        <p>Якщо застосунок показує dBm, введіть від’ємні числа, наприклад <b>−45</b> або <b>−70</b>. Якщо бачите лише поділки, виберіть «Поділки» та введіть число від 1 до 4.</p>
        <div class="learn"><b>Що таке dBm?</b> Це одиниця, у якій застосунок може показувати потужність отриманого радіосигналу. Значення Wi-Fi часто від’ємні. <b>−45 dBm сильніше за −70 dBm</b>, бо −45 більше за −70. Поділки на значку Wi-Fi дають лише приблизну оцінку.</div>
        <div class="check" data-answer="-45"><b>Швидка перевірка: який сигнал сильніший?</b><button type="button" data-choice="-45">−45 dBm</button><button type="button" data-choice="-70">−70 dBm</button><p class="feedback" aria-live="polite"></p></div>
        <label for="units">Який показник ви вимірюєте?</label>
        <select id="units" data-save><option value="dbm">Сила сигналу (dBm)</option><option value="bars">Поділки сигналу (1–4)</option></select>
      </div>
      <div class="art"><img alt="Вимірювання Wi-Fi смартфоном" data-future-image="image2.png"><div class="placeholder"><span class="symbol">▥</span>Місце для зображення 2<br>Вимірювання смартфоном</div></div>
    </div>
    <div class="scroller"><table aria-label="Таблиця вимірювань"><thead><tr><th>Точка</th><th>Вимір 1</th><th>Вимір 2</th><th>Вимір 3</th><th>Середнє</th><th>Розкид</th></tr></thead><tbody id="rows"></tbody></table></div>
    <p class="small">Розкид = найбільше значення мінус найменше. Менший розкид означає, що виміри в цій точці ближчі один до одного.</p>
    <div class="actions"><button class="primary" data-next="3">Побачити результати →</button></div>
  </section>

  <section class="panel" id="step3">
    <h2>Крок 3. Перетворіть числа на карту · 8 хв</h2>
    <p>Натисніть «Порахувати»: програма знайде середнє і позначить точки на карті кольорами. Для dBm число <b>−45</b> означає сильніший сигнал, ніж <b>−70</b>: сильніший сигнал має більше числове значення.</p>
    <div class="learn"><b>Як рахуємо?</b> Середнє трьох показників: (вимір 1 + вимір 2 + вимір 3) ÷ 3. Наприклад, для −50, −52 і −51 dBm середнє дорівнює <b>−51 dBm</b>. Повторення допомагають помітити випадкові коливання.</div>
    <div class="actions"><button class="primary" id="calculate">Порахувати і розфарбувати карту</button><button class="secondary" id="downloadMap">Завантажити карту PNG</button><button class="secondary" id="downloadCsv">Завантажити таблицю CSV</button></div>
    <div id="summary" class="result" role="status">Заповніть вимірювання та натисніть «Порахувати».</div>
    <h3>Запитання до даних</h3>
    <label for="analysis">Чи підтвердилася гіпотеза? Що могло вплинути на різницю між точками?</label>
    <textarea id="analysis" placeholder="Порівняйте конкретні числа, зазначте можливий вплив стін і відстані..." data-save></textarea>
    <p class="note">Сила Wi-Fi-сигналу не дорівнює швидкості інтернету. Якщо відеоурок переривається, причина може бути також у завантаженні мережі або з’єднанні з провайдером.</p>
    <div class="check" data-answer="no"><b>Чи доводить сильний Wi-Fi-сигнал, що інтернет точно буде швидким?</b><button type="button" data-choice="yes">Так, цього достатньо</button><button type="button" data-choice="no">Ні, швидкість залежить також від інших умов</button><p class="feedback" aria-live="polite"></p></div>
    <div class="actions"><button class="primary" data-next="4">Запропонувати покращення →</button></div>
  </section>

  <section class="panel" id="step4">
    <div class="two">
      <div>
        <h2>Крок 4. Перевірте своє рішення</h2>
        <p>Оберіть місце для онлайн-уроку. У груповій кімнаті покажіть умовну карту, поясніть висновок і запропонуйте одну доступну зміну: місця роботи або положення роутера, якщо це дозволено вдома.</p>
        <div class="learn"><b>Від дослідження до інженерного рішення.</b> Спочатку визначте критерій: наприклад, сигнал має бути сильнішим і достатньо стабільним. Потім змініть <b>одну</b> умову, повторіть вимірювання тим самим смартфоном і порівняйте дані «до» та «після».</div>
        <label for="chosen">Яке місце ви обрали і на підставі яких вимірювань?</label><textarea id="chosen" data-save></textarea>
        <label for="change">Що саме змінили або пропонуєте змінити?</label><textarea id="change" data-save></textarea>
        <label for="before">Показник до зміни</label><input id="before" type="number" data-save placeholder="Наприклад, -68">
        <label for="after">Показник після зміни</label><input id="after" type="number" data-save placeholder="Наприклад, -55">
        <label for="conclusion">Що показало повторне вимірювання? Яке нове запитання виникло?</label><textarea id="conclusion" data-save></textarea>
        <div class="box"><b>Виступ групи, 60 секунд:</b> проблема → карта → дані → перевірена зміна → висновок.</div>
        <div class="actions"><button class="secondary" onclick="window.print()">Роздрукувати або зберегти PDF</button></div>
      </div>
      <div>
        <div class="art"><img alt="Карта Wi-Fi і рішення" data-future-image="image3.png"><div class="placeholder"><span class="symbol">◎</span>Місце для зображення 3<br>Карта сигналу та рішення</div></div>
        <h3>Які знання знадобилися?</h3>
        <p><b>Фізика:</b> поширення радіосигналу та вплив перешкод.<br><b>Математика:</b> повторні вимірювання, середнє та розкид.<br><b>Інформатика:</b> мережа, таблиця, цифрова карта й аналіз даних.<br><b>Інженерія:</b> пропозиція, перевірка та вдосконалення рішення.</p>
      </div>
    </div>
  </section>
  <p class="footerline">Квест працює як один HTML-файл, зберігає заповнені поля лише в цьому браузері. Зображення для трьох позначених місць можна додати пізніше.</p>
</main>
<script>
(() => {
  const letters=['А','Б','В','Г','Д'], key='wifi-stem-quest-v1';
  const canvas=document.getElementById('map'), ctx=canvas.getContext('2d');
  const cols=16,rows=10,cell=50;
  const state=JSON.parse(localStorage.getItem(key)||'null')||{wall:[],router:null,points:[],measure:{},unit:'dbm'};
  state.wall ||= []; state.points ||= []; state.measure ||= {};
  let tool='wall', average={};
  const save=()=>localStorage.setItem(key,JSON.stringify(state));
  const cellAt=e=>{let b=canvas.getBoundingClientRect(); return {x:Math.min(cols-1,Math.max(0,Math.floor((e.clientX-b.left)/b.width*cols))),y:Math.min(rows-1,Math.max(0,Math.floor((e.clientY-b.top)/b.height*rows)))};};
  const equal=(a,b)=>a&&b&&a.x===b.x&&a.y===b.y;
  function draw(){
    ctx.clearRect(0,0,800,500);ctx.fillStyle='#f8fbff';ctx.fillRect(0,0,800,500);
    ctx.strokeStyle='#d8e6f1';ctx.lineWidth=1;
    for(let x=0;x<=cols;x++){ctx.beginPath();ctx.moveTo(x*cell,0);ctx.lineTo(x*cell,500);ctx.stroke();}
    for(let y=0;y<=rows;y++){ctx.beginPath();ctx.moveTo(0,y*cell);ctx.lineTo(800,y*cell);ctx.stroke();}
    state.wall.forEach(p=>{ctx.fillStyle='#607993';ctx.fillRect(p.x*cell+2,p.y*cell+2,cell-4,cell-4);});
    if(state.router){let p=state.router;ctx.fillStyle='#1469ad';ctx.beginPath();ctx.arc(p.x*cell+25,p.y*cell+25,20,0,7);ctx.fill();ctx.fillStyle='white';ctx.font='bold 22px Arial';ctx.textAlign='center';ctx.fillText('R',p.x*cell+25,p.y*cell+33);}
    const vals=Object.values(average),low=Math.min(...vals),high=Math.max(...vals);
    state.points.forEach((p,i)=>{let a=average[letters[i]],ratio=a===undefined?.5:(high===low?1:(a-low)/(high-low));ctx.fillStyle=a===undefined?'#b1831a':ratio>=.66?'#258954':ratio>=.33?'#e8ad30':'#d4584c';ctx.beginPath();ctx.arc(p.x*cell+25,p.y*cell+25,20,0,7);ctx.fill();ctx.fillStyle='white';ctx.font='bold 22px Arial';ctx.textAlign='center';ctx.fillText(letters[i],p.x*cell+25,p.y*cell+32);});
  }
  canvas.addEventListener('pointerdown',e=>{let p=cellAt(e), w=state.wall.findIndex(q=>equal(q,p)), i=state.points.findIndex(q=>equal(q,p));
    if(tool==='erase'){if(w>=0)state.wall.splice(w,1);if(i>=0)state.points.splice(i,1);if(equal(state.router,p))state.router=null;average={};}
    if(tool==='wall'&&i<0&&!equal(state.router,p)&&w<0)state.wall.push(p);
    if(tool==='router'&&w<0&&i<0)state.router=p;
    if(tool==='point'&&w<0&&!equal(state.router,p)&&i<0&&state.points.length<5)state.points.push(p);
    save();draw();renderRows();
  });
  document.querySelectorAll('.tool').forEach(btn=>btn.addEventListener('click',()=>{tool=btn.dataset.tool;document.querySelectorAll('.tool').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));}));
  document.getElementById('resetMap').onclick=()=>{if(!confirm('Очистити карту та позначені точки?'))return;state.wall=[];state.router=null;state.points=[];average={};save();draw();renderRows();};
  function renderRows(){let tbody=document.getElementById('rows');tbody.replaceChildren();letters.forEach((name,i)=>{let tr=document.createElement('tr'), valid=i<state.points.length;let label=document.createElement('th');label.textContent=name+(valid?'':' (додайте на карті)');tr.append(label);
    for(let j=0;j<3;j++){let td=document.createElement('td'),input=document.createElement('input');input.type='number';input.inputMode='decimal';input.setAttribute('aria-label',`Точка ${name}, вимір ${j+1}`);input.disabled=!valid;input.value=state.measure[name]?.[j]??'';input.addEventListener('input',()=>{state.measure[name]||=['','',''];state.measure[name][j]=input.value;save();});td.append(input);tr.append(td);}
    for(let j=0;j<2;j++){let td=document.createElement('td');td.id=(j?'range-':'avg-')+name;td.textContent='—';tr.append(td);}tbody.append(tr);});}
  function calculate(){average={};const unit=document.getElementById('units').value;let invalid=[];
    state.points.forEach((p,i)=>{const name=letters[i], raw=state.measure[name]||[], values=raw.map(v=>v===''?NaN:Number(v));if(values.length!==3||values.some(v=>!Number.isFinite(v)|| (unit==='bars'?(v<1||v>4):(v>0||v< -120)))){invalid.push(name);return;}
      average[name]=values.reduce((a,b)=>a+b,0)/3;document.getElementById('avg-'+name).textContent=average[name].toFixed(1);document.getElementById('range-'+name).textContent=(Math.max(...values)-Math.min(...values)).toFixed(1);
    });draw();let summary=document.getElementById('summary');if(!state.points.length){summary.textContent='Спочатку додайте точки на карту.';return;}
    if(invalid.length)summary.textContent=`У точках ${invalid.join(', ')} потрібно вказати три коректні вимірювання.`;
    else {let best=Object.entries(average).sort((a,b)=>b[1]-a[1])[0];summary.textContent=`За середнім показником найсильніший сигнал у точці ${best[0]} (${best[1].toFixed(1)} ${unit==='dbm'?'dBm':'поділки'}). Перевірте також розкид та свої спостереження.`;}
  }
  document.getElementById('calculate').onclick=calculate;
  document.getElementById('downloadMap').onclick=()=>{calculate();let a=document.createElement('a');a.href=canvas.toDataURL('image/png');a.download='karta-wifi.png';a.click();};
  document.getElementById('downloadCsv').onclick=()=>{calculate();let u=document.getElementById('units').value;let lines=['Точка;Вимір 1;Вимір 2;Вимір 3;Середнє ('+u+')'];state.points.forEach((_,i)=>{let n=letters[i];lines.push([n,...(state.measure[n]||['','','']),average[n]?.toFixed(1)||''].join(';'));});let a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+lines.join('\n')],{type:'text/csv;charset=utf-8'}));a.download='vymiriannia-wifi.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000);};
  document.querySelectorAll('[data-save]').forEach(el=>{let k=el.id;if(k==='units')el.value=state.unit;else if(state[k]!==undefined)el.value=state[k];el.addEventListener('input',()=>{state[k]=el.value;if(k==='units'){state.unit=el.value;average={};draw();}save();});});
  function show(n){document.querySelectorAll('.panel').forEach((el,i)=>el.classList.toggle('active',i===n));document.querySelectorAll('nav button').forEach((el,i)=>{if(i===n)el.setAttribute('aria-current','step');else el.removeAttribute('aria-current');});window.scrollTo({top:0,behavior:'smooth'});}
  document.querySelectorAll('[data-step],[data-next]').forEach(btn=>btn.addEventListener('click',()=>show(Number(btn.dataset.step??btn.dataset.next))));
  document.querySelectorAll('.check').forEach(box=>box.querySelectorAll('[data-choice]').forEach(btn=>btn.addEventListener('click',()=>{let ok=btn.dataset.choice===box.dataset.answer;box.querySelector('.feedback').textContent=ok?'Так! Перевірте це на власних вимірюваннях.':box.dataset.answer==='-45'?'Спробуйте порівняти числа: −45 більше за −70.':'Подумайте, що ще може сповільнювати з’єднання, навіть коли Wi-Fi сильний.';box.querySelector('.feedback').style.color=ok?'#177449':'#9a5314';})));
  draw();renderRows();
})();
</script>
</body>
</html>
